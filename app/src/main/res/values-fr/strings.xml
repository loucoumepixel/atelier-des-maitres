    <string name="monet_impression_title">Impression, soleil levant</string>
    <string name="monet_impression_note">Le port du Havre au petit matin. Un critique moqua ce titre : le mot « impressionnisme » était né.</string>
    <string name="monet_nympheas_title">Nymphéas</string>
    <string name="monet_nympheas_note">Monet a peint plus de 250 fois les nymphéas de son étang de Giverny, à toutes les heures du jour.</string>
    <string name="monet_prairie_title">Prairie à Giverny</string>
    <string name="monet_prairie_note">Installé à Giverny, Monet peint la campagne autour de sa maison sous toutes les lumières, avant de créer son célèbre jardin d\'eau.</string>
    <string name="panier_pommes_title">Le Panier de pommes</string>
    <string name="panier_pommes_year">vers 1893</string>
    <string name="panier_pommes_note">La table penche, la bouteille aussi : Cézanne montre chaque objet sous son meilleur angle, quitte à tordre la perspective.</string>
    <string name="voyageur_brume_title">Le Voyageur contemplant une mer de nuages</string>
    <string name="voyageur_brume_year">vers 1818</string>
    <string name="voyageur_brume_note">L\'icône du romantisme allemand. On ne voit jamais le visage du voyageur : c\'est nous qui regardons la brume avec lui.</string>
    <string name="pont_neuf_title">Le Pont-Neuf</string>
    <string name="pont_neuf_note">Renoir peignit la foule depuis l\'étage d\'un café ; son frère arrêtait les passants pour les faire poser un instant.</string>
    <string name="grande_jatte_title">Un dimanche après-midi à l\'île de la Grande Jatte</string>
    <string name="grande_jatte_note">Deux ans de travail, point par point : Seurat juxtapose des touches de couleur pure que l\'œil mélange de loin.</string>
    <string name="noce_juive_title">Noce juive dans le Maroc</string>
    <string name="noce_juive_year">vers 1839</string>
    <string name="noce_juive_note">Delacroix assista à cette fête à Tanger en 1832 et la peignit de mémoire, carnets de croquis à l\'appui.</string>
    <string name="vermeer_laitiere_title">La Laitière</string>
    <string name="vermeer_laitiere_year">vers 1658</string>
    <string name="vermeer_laitiere_note">Un filet de lait, un rayon de lumière : Vermeer fait d\'un geste de cuisine un instant suspendu.</string>
    <string name="american_gothic_title">American Gothic</string>
    <string name="american_gothic_note">Wood fit poser sa sœur et son dentiste devant une maison de l\'Iowa. On les croit mari et femme ; il les voulait père et fille.</string>
    <string name="liberte_peuple_title">La Liberté guidant le peuple</string>
    <string name="liberte_peuple_note">Peinte en l\'honneur des Trois Glorieuses de juillet 1830. Restaurée en 2024, elle a retrouvé ses couleurs vives.</string>
    <string name="naissance_venus_title">La Naissance de Vénus</string>
    <string name="naissance_venus_year">vers 1485</string>
    <string name="naissance_venus_note">Zéphyr souffle la déesse vers le rivage, où une Heure l\'attend avec un manteau fleuri.</string>
    <string name="joconde_title">La Joconde</string>
    <string name="joconde_artist">Léonard de Vinci</string>
    <string name="joconde_nickname">Léonard</string>
    <string name="joconde_note">Léonard la garda toute sa vie et la retoucha sans cesse. Son sourire tient au sfumato, ces contours fondus dans l\'ombre.</string>
