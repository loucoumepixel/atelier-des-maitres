    <string name="nuit_etoilee_title">La Nuit étoilée</string>
    <string name="nuit_etoilee_note">Peinte depuis sa chambre de l\'asile de Saint-Rémy-de-Provence, juste avant le lever du soleil. Le village, lui, est imaginé.</string>
    <string name="champ_de_ble_cypres_title">Champ de blé avec cyprès</string>
    <string name="champ_de_ble_cypres_note">Van Gogh voyait dans les cyprès « l\'équivalent d\'un obélisque égyptien ». Il peignit trois versions de ce paysage.</string>
    <string name="cafe_de_nuit_title">Le Café de nuit</string>
    <string name="cafe_de_nuit_note">« J\'ai cherché à exprimer avec le rouge et le vert les terribles passions humaines », écrit-il à son frère Théo.</string>
    <string name="maisons_personnage_title">Maisons et personnage</string>
    <string name="maisons_personnage_note">Un souvenir du Nord peint à Saint-Rémy : chaumières, fumées en volutes et soleil couchant.</string>
    <string name="grande_vague_title">La Grande Vague de Kanagawa</string>
    <string name="grande_vague_year">vers 1831</string>
    <string name="grande_vague_note">Estampe des Trente-six vues du mont Fuji. Le bleu de Prusse, alors nouveau au Japon, y fait une entrée fracassante.</string>
    <string name="naufrage_minotaure_title">Le Naufrage du Minotaure</string>
    <string name="naufrage_minotaure_year">vers 1810</string>
    <string name="naufrage_minotaure_note">Turner, peintre de la lumière et des tempêtes, annonce ici les impressionnistes de plus d\'un demi-siècle.</string>
    <string name="le_cri_title">Le Cri</string>
    <string name="le_cri_note">« Je sentis un cri infini qui traversait la nature. » Le ciel rouge serait celui d\'un crépuscule sur Oslo.</string>
